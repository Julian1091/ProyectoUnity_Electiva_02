  panelTutorial: {fileID: 328760836}
  textoPaso: {fileID: 419610207}
  imagenPaso: {fileID: 1896246258}
  textoBoton: {fileID: 0}
  pasos:
  - texto: '" Toca la pantalla para saltar y utiliza el Joystick para esquivar objetos"'
    imagenOpcional: {fileID: 21300000, guid: 6b820353b5970f9418dfe08a317ba79d, type: 3}
  - texto: "\"Evita: secador, bolsa de basura y matera \u2014 \xA1te quitan vidas!\""
    imagenOpcional: {fileID: 21300000, guid: 27d57d6dca6f2064ca43490a27d0bf3e, type: 3}
  - texto: "\" Recoge comida, at\xFAn y pez para llenar la barra y engordar al gato
      callejero, ganas con 100 puntos\"\""
    imagenOpcional: {fileID: 21300000, guid: cd3b3332f93890647b615fcff5179f9b, type: 3}
  itemSpawner: {fileID: 1430836759}
